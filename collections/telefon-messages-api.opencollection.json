{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telefon Number Management Available Numbers Messages API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telefon.com/v1/numbers/messages",
            "params": [
              {
                "name": "direction",
                "value": "",
                "type": "query",
                "description": "Filter by direction"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by status"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Results per page"
              }
            ]
          },
          "docs": "List sent and received messages with filtering options."
        },
        {
          "info": {
            "name": "Send Message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telefon.com/v1/numbers/messages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Send an SMS or MMS message."
        },
        {
          "info": {
            "name": "Get Message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telefon.com/v1/numbers/messages/:message_id",
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path",
                "description": "Unique message identifier"
              }
            ]
          },
          "docs": "Get details for a specific message."
        },
        {
          "info": {
            "name": "Delete Message",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telefon.com/v1/numbers/messages/:message_id",
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path",
                "description": "Unique message identifier"
              }
            ]
          },
          "docs": "Delete a message record."
        }
      ]
    }
  ],
  "bundled": true
}