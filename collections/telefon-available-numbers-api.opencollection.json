{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telefon Number Management Available Numbers API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Available Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Available Numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telefon.com/v1/numbers/available",
            "params": [
              {
                "name": "country_code",
                "value": "",
                "type": "query",
                "description": "ISO 3166-1 alpha-2 country code"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Number type"
              },
              {
                "name": "area_code",
                "value": "",
                "type": "query",
                "description": "Area code for local numbers"
              },
              {
                "name": "sms_enabled",
                "value": "",
                "type": "query",
                "description": "Filter for SMS-capable numbers"
              },
              {
                "name": "voice_enabled",
                "value": "",
                "type": "query",
                "description": "Filter for voice-capable numbers"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max results to return"
              }
            ]
          },
          "docs": "Search for available phone numbers matching specified criteria."
        }
      ]
    }
  ],
  "bundled": true
}